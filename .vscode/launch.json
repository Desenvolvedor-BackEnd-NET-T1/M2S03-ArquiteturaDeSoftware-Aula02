    {
      "name": "PizzariaByte MVC (5101)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-mvc",
      "program": "${workspaceFolder}/mvc/src/PizzariaByte.Mvc/bin/Debug/net10.0/PizzariaByte.Mvc.dll",
      "args": [],
      "cwd": "${workspaceFolder}/mvc/src/PizzariaByte.Mvc",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5101"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
