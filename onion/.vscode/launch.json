{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PizzariaByte Onion (5103)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/PizzariaByte.Onion.Web/bin/Debug/net10.0/PizzariaByte.Onion.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/PizzariaByte.Onion.Web",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5103"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
