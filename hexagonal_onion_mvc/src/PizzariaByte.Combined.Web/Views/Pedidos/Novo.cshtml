@model NovoPedidoViewModel
@{
    ViewData["Title"] = "Novo pedido";
}
<h1>Novo pedido</h1>
<form asp-action="Novo" method="post">
    <div asp-validation-summary="All"></div>

    <div class="campo">
        <label asp-for="PizzaId"></label>
        <select asp-for="PizzaId" asp-items="@(new SelectList(Model.Cardapio.Select(p => new { p.Id, Texto = $"{p.Nome} — {p.Preco:C}" }), "Id", "Texto"))">
            <option value="">Selecione...</option>
        </select>
    </div>

    <div class="campo">
        <label asp-for="Quantidade"></label>
        <input asp-for="Quantidade" type="number" min="1" max="50" />
    </div>

    <div class="campo">
        <label asp-for="EnderecoEntrega"></label>
        <input asp-for="EnderecoEntrega" maxlength="200" placeholder="Rua das Flores, 123" />
    </div>

    <p>Taxa de entrega: R$ 8,00 — grátis para pedidos a partir de R$ 100,00.</p>
    <button class="botao" type="submit">Confirmar pedido</button>
</form>
